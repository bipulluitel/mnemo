{
  "name": "mnemo",
  "version": "0.1.0",
  "description": "Persistent memory, personality profiling, task scheduling, and Telegram messaging for Claude",
  "author": {
    "name": "Bipul Luitel",
    "url": "https://github.com/bipulluitel"
  },
  "homepage": "https://github.com/bipulluitel/mnemo",
  "repository": "https://github.com/bipulluitel/mnemo",
  "license": "MIT",
  "keywords": ["memory", "persistence", "profile", "scheduling", "telegram", "sqlite"],
  "mcpServers": {
    "mnemo-mcp": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-servers/mnemo-mcp/dist/index.js"],
      "env": {
        "MNEMO_CONFIG_PATH": "~/.mnemo/config.json"
      }
    }
  }
}
